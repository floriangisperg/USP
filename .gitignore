.tox/
.nox/
.hypothesis/

# =============================================================================
# Data, outputs, and notebooks
# =============================================================================
# Raw data, generated outputs, and plots are kept OUT of git. We ignore by
# extension (data/output file types) — simpler than scattering path rules across
# the example dirs — then re-allow the few locations that must be trackable.
# Raw experiment data dirs and the modeling archive's generated material.
# (gitignore has no trailing comments — keep the patterns bare.)
examples/**/data/
archive/**/data/
archive/**/results/
archive/**/outputs/

# Data / output file types — not tracked anywhere by default
*.csv
*.xlsx
*.png
*.jpg
*.jpeg
*.svg
*.pdf
*.ipynb
*.html
# Lab instrument / analysis software formats (SDS-PAGE scans, MODDE, flow
# cytometry, Origin projects, FelxStart) — raw data stays out of the repo
*.scn
*.mip
*.fcs
*.opju
*.fey
*.cmbx

# Consolidated / compiled data exports
**/*consolidated*.xlsx
**/*compiled*.xlsx

# Re-allow test fixtures (in-memory today, but permit future fixture files)
!tests/fixtures/
!tests/fixtures/**


# =============================================================================
# Scratch / experimental work (not part of the package)
# =============================================================================
**/archive/
**/*_archived/

# The modeling archive is kept IN the repo on purpose (2026-11-19): code,
# docs and configs under archive/ are tracked; its data/results/outputs
# dirs and binary formats stay local via the rules above. Nested archive/
# and *_archived/ dirs inside it remain ignored.
!archive/
# Archive-specific: serialized caches stay local; the one-off provenance
# notebook is tracked despite the global *.ipynb rule.
archive/**/*.pkl
!archive/**/*.ipynb
**/tmpclaude-*
.claude/

# =============================================================================
# Jupyter
# =============================================================================
.ipynb_checkpoints/
.virtual_documents/

# =============================================================================
# Type checkers / linters
# =============================================================================
.pyre/
.dmypy.json
dmypy.json
.cache

# =============================================================================
# IDEs
# =============================================================================
.vscode/
.idea/
*.swp
*.swo
*~

# =============================================================================
# OS
# =============================================================================
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# =============================================================================
# Logs / temp
# =============================================================================
*.log
*.tmp
*.temp

# =============================================================================
# Misc generated artifacts
# =============================================================================
# Incorrect site-packages dumped in project root
Python3*/
